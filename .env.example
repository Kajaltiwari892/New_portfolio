# Firebase web configuration is public; backend Security Rules protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Only enable after deploying and verifying firestore.rules and App Check.
VITE_ANALYTICS_ENABLED=false
# Comma-separated production hostnames. Localhost is never tracked.
VITE_ANALYTICS_HOSTS=
